  "queries": [
    {
      "task_id": "feature_01",
      "instruction": "Our Cookie Doughs are all hand made with only the finest ingredients, including, butter, shortening, fresh eggs, fine chocolates, and delicious nuts. They come shipped in a air tight shipping container, complete with freezer packs, to ensure freshness. We have many flavors, some that you scoop out with a spoon, or roll out for different shapes, or some that you can squeeze out with a pastry bag. You can also include a gift message.",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_02",
      "instruction": "HOMEMADE TASTE: Classic sugar cookie dough for any occasion",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_03",
      "instruction": "Peel back the top, grab a spoon, enjoy the vanilla and cinnamon notes on your nose, and dig in to the sweet, creamy dessert in a cup that tastes just like the classic cookie.",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_04",
      "instruction": "All-natural Ingredients - We only use the best to create our cookies dough. With real Idaho butter, American wheat flour, Madagascar vanilla, Wisconsin cherries, West African chocolate chips, and sea salt, this cookie mix is truly mouthwatering.",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_05",
      "instruction": "Great for Snack and Dessert Time - Eat it by the spoonful. Mix or top over your favorite ice cream scoop. Smash it between 2 chocolate crinkle cookies.",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_06",
      "instruction": "DESSERT: Immaculate Baking cookie dough is made with wholesome ingredients and is the perfect dessert satisfy those late night cravings",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_07",
      "instruction": "Ready to Eat - Grab a spoon because this is the perfect edible cookie dough. No need to make dough from scratch. Enjoy your edible cookie dough right of the scoop straight from the tub!",
      "query_mode": "text",
      "query_image": null,
      "query_image_sha256": null
    },
    {
      "task_id": "feature_08",
      "instruction": "Classic chocolate chip cookie Dough, as featured in our Caramel Chocolate double dough ice cream!",
      "query_mode": "text",
