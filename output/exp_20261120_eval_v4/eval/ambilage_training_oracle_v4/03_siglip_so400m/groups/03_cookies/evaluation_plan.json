      "query_image_sha256": null
    },
    {
      "task_id": "feature_09",
      "instruction": "Once you’ve discovered the coolest ever cache of Ben & Jerry's cookie dough chunks you can grab straight from the package, we think you’ll agree it’s the direct est route to dough phoria you can get",
      "query_mode": "text",
