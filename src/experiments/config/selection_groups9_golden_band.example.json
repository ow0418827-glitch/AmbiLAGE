{
  "schema_version": 2,
  "strategy": "median",
  "seed": 42,
  "preprocessing": "foreground_crop_gray_letterbox224_global_cls_v1",
  "candidate_limit": 64,
  "expand_candidate_limits": [128, 256, 512, 1024],
  "calibration_path": "output/datasets/public/calibration/shape_fg_crop_v1/threshold.json",
  "models": {"batch_size": 16},
  "public_rank_band": {
    "enabled": true,
    "peer_count": 20,
    "rank_min": 5,
    "rank_max": 12,
    "scorer": "dino_lexical_hybrid"
